# Copy this file to .env and fill in GROQ_API_KEY.
# Never commit .env — it is ignored by git.
# Variable names map case-insensitively to config/settings.py fields.

# ---------------------------------------------------------------------------
# LLM (Groq)
# ---------------------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Free-tier chat models as of 2026: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b. Llama models are enterprise-only now.
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Embeddings (local Hugging Face)
# ---------------------------------------------------------------------------
# Downloaded once to the Hugging Face cache (~90 MB), then runs offline on CPU.
# EMBEDDING_MODEL (without the _NAME suffix) is also accepted for compatibility.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Keep the default small on Groq's free tier (8K tokens/minute).
DEFAULT_TOP_K=3
MAX_TOP_K=20
MAX_QUESTION_LENGTH=4000
MAX_SELECTED_DOCUMENTS=50

# ---------------------------------------------------------------------------
# Storage (relative paths are resolved against the project root)
# ---------------------------------------------------------------------------
CHROMA_COLLECTION_NAME=document_collection_v2
CHROMA_PERSIST_DIRECTORY=data/chroma_db
UPLOAD_DIRECTORY=data/uploads

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=10485760
MAX_FILENAME_LENGTH=200
# JSON list; also enforced client-side by the frontend.
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt"]

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=Document Chatbot API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# JSON list. The bundled frontend is served same-origin, so "*" is fine locally.
CORS_ALLOW_ORIGINS=["*"]
